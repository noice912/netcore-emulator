{
  "network": {
    "bindAddress": "0.0.0.0",
    "loopbackOnly": false,
    "maxSessions": 1024,
    "maxSessionsPerAddress": 16,
    "dispatch": {
      "enabled": true,
      "bindAddress": "",
      "port": 22101,
      "backlog": 128,
      "idleTimeoutSeconds": 90,
      "maxPayloadBytes": 65536
    },
    "gateway": {
      "enabled": true,
      "bindAddress": "",
      "port": 22102,
      "sessionTimeoutSeconds": 60,
      "maxPayloadBytes": 1400,
      "socketBufferBytes": 1048576
    }
  },
  "security": {
    "requireHandshake": false,
    "handshakeTimeoutSeconds": 10,
    "allowedProtocolVersions": [
      1
    ],
    "maxUnknownPacketsPerSession": 32,
    "maxMalformedPacketsPerSession": 8,
    "rateLimit": {
      "enabled": true,
      "packetsPerSecond": 200,
      "burst": 400,
      "maxViolations": 10
    },
    "encryption": {
      "enabled": false,
      "keyHex": ""
    }
  },
  "engine": {
    "workerThreads": 0,
    "configWatchEnabled": true,
    "configWatchDebounceMillis": 300,
    "logUnknownOpcodes": true,
    "consoleEnabled": true,
    "heartbeatIntervalSeconds": 30,
    "maintenanceIntervalSeconds": 5,
    "tickEnabled": true,
    "ticksPerSecond": 20,
    "pluginsEnabled": true,
    "pluginDirectory": "plugins"
  },
  "persistence": {
    "enabled": true,
    "directory": "data",
    "autosaveIntervalSeconds": 60,
    "namespaces": []
  },
  "schemas": {
    "enabled": true,
    "directory": "schemas",
    "hotReload": true,
    "debounceMillis": 300
  },
  "admin": {
    "enabled": true,
    "bindAddress": "127.0.0.1",
    "port": 22180,
    "allowRemote": false
  },
  "capture": {
    "enabled": false,
    "directory": "captures",
    "includePayload": true,
    "maxBytesPerFrame": 256
  }
}
